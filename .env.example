# Copy this file to .env on the server. Never upload .env to public Git repositories.
PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development
DATA_DIR=./data

# PayPal Developer app credentials. Start in sandbox, switch to live only after tests.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=replace_with_sandbox_client_id
PAYPAL_CLIENT_SECRET=replace_with_sandbox_secret

# SMTP settings for automated delivery. Use an email provider/app password, not your email login.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Construir Juntos <no-reply@example.com>

# Optional admin token for the basic order-status endpoint. Generate a long random value.
ADMIN_TOKEN=replace_with_a_long_random_secret
